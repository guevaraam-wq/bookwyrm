@startuml
title BookWyrm Trust Boundary Diagram

rectangle "Web Browser" as Browser
rectangle "BookWyrm Application" as App
database "BookWyrm Database" as DB

Browser --> App : 1. User/Application Boundary - Django validates input
App --> DB : 2. Database Boundary - Check access permissions
rectangle "Authentication and Authorization" as Auth
rectangle "External Book Data Service" as External
App --> Auth : 3. Authentication Boundary - Check permissions
App --> External : 4. External Service Boundary - Request book data
External --> App : 5. Validate returned data
@enduml